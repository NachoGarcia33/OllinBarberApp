@{
    ViewData["Title"] = "Inicio";
}

<style>

    .hero {
        position: relative;
        min-height: calc(100vh - 90px);
        background-image: linear-gradient( rgba(0,0,0,.72), rgba(0,0,0,.82) ), url('/images/fondo.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

        /* EFECTO CINEMATOGRÁFICO */

        .hero::before {
            content: "";
            position: absolute;
            width: 900px;
            height: 900px;
            background: radial-gradient( circle, rgba(212,175,55,.12), transparent 70% );
            top: -250px;
            right: -250px;
            border-radius: 50%;
            filter: blur(60px);
        }

        .hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( to top, rgba(0,0,0,.82), rgba(0,0,0,.25), rgba(0,0,0,.72) );
        }

    .contenido {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 1100px;
        padding: 40px 20px;
    }

    /* TITULO */

    .branding h1 {
        font-family: 'Cinzel', serif;
        font-size: clamp(3rem, 8vw, 7rem);
        color: #d4af37;
        letter-spacing: 8px;
        margin-bottom: 18px;
        font-weight: 700;
        text-shadow: 0 0 30px rgba(212,175,55,.15);
        animation: fadeLuxury 1.2s ease;
    }

    /* SUBTITULO */

    .subtitulo {
        color: rgba(255,255,255,.82);
        font-size: clamp(1rem, 2vw, 1.4rem);
        letter-spacing: 3px;
        margin-bottom: 50px;
        font-weight: 300;
        animation: fadeLuxury 1.6s ease;
    }

    /* BOTONES */

    .botones {
        display: flex;
        justify-content: center;
        gap: 22px;
        flex-wrap: wrap;
        animation: fadeLuxury 2s ease;
    }

    .btn-barber {
        padding: 16px 34px;
        min-width: 220px;
        border-radius: 18px;
        border: 1px solid rgba(212,175,55,.35);
        background: rgba(20,20,20,.45);
        backdrop-filter: blur(12px);
        color: #d4af37;
        text-decoration: none;
        font-weight: 600;
        letter-spacing: 1px;
        transition: .35s ease;
        box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }

        .btn-barber:hover {
            transform: translateY(-6px) scale(1.03);
            background: rgba(212,175,55,.15);
            color: white;
            border-color: #d4af37;
            box-shadow: 0 18px 40px rgba(212,175,55,.15);
        }

    /* EFECTO APARICIÓN */

    @@keyframes fadeLuxury {

        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* MOBILE */

    @@media(max-width:768px) {

        .hero {
            padding: 40px 20px 80px;
        }

        .branding h1 {
            letter-spacing: 4px;
        }

        .subtitulo {
            line-height: 1.8;
            margin-bottom: 35px;
        }

        .btn-barber {
            width: 100%;
            max-width: 320px;
        }
    }

    .cumple-box {
        margin-top: 60px;
        max-width: 650px;
        margin-left: auto;
        margin-right: auto;
        padding: 35px;
        border-radius: 20px;
        background: rgba(20,20,20,.60);
        border: 1px solid rgba(212,175,55,.25);
        backdrop-filter: blur(10px);
    }

        .cumple-box h3 {
            color: #d4af37;
            margin-bottom: 15px;
            font-family: 'Cinzel',serif;
        }

        .cumple-box p {
            color: #EAEAEA;
            margin-bottom: 12px;
            line-height: 1.7;
        }

    .btn-registro {
        display: inline-block;
        margin-top: 15px;
        padding: 14px 30px;
        border-radius: 14px;
        background: #d4af37;
        color: #111;
        text-decoration: none;
        font-weight: bold;
        transition: .3s;
    }

        .btn-registro:hover {
            background: #e4bd43;
            transform: translateY(-3px);
            color: #000;
        }

    .login-texto {
        margin-top: 18px;
        color: #bbb;
    }

        .login-texto a {
            color: #d4af37;
            text-decoration: none;
            font-weight: bold;
        }


    .birthday-title {
        color: #d4af37;
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        letter-spacing: 1px;
    }

        .birthday-title i {
            color: #f3d27a;
        }

    .birthday-badge {
        display: inline-block;
        padding: 6px 14px;
        margin-bottom: 18px;
        border: 1px solid rgba(212,175,55,.35);
        border-radius: 50px;
        color: #d4af37;
        font-size: .75rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        background: rgba(212,175,55,.08);
    }

    .birthday-title {
        color: #d4af37;
        font-family: 'Playfair Display',serif;
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

        .birthday-title i {
            color: #f3d27a;
        }

    .birthday-divider {
        width: 90px;
        height: 3px;
        margin: 18px auto 28px;
        border-radius: 20px;
        background: linear-gradient(90deg,#8b6a12,#d4af37,#f3d27a,#8b6a12);
    }

    .birthday-text {
        color: #ececec;
        font-size: 1.15rem;
        line-height: 1.9;
    }

        .birthday-text strong {
            color: #f3d27a;
        }

    /*=========================================
      PRUEBA SOCIAL
    ==========================================*/

    .hero-rating {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 45px;
        padding: 12px 22px;
        border-radius: 50px;
        background: rgba(212,175,55,.08);
        border: 1px solid rgba(212,175,55,.20);
        color: #f3d27a;
        font-size: 1rem;
        font-weight: 600;
        backdrop-filter: blur(12px);
        animation: fadeLuxury 2.2s ease;
    }

        .hero-rating strong {
            color: white;
        }

</style>

<section class="hero">

    <div class="contenido">

        <div class="branding">

            <h1>
                OLLIN BARBER
            </h1>

        </div>

        <p class="subtitulo">

            Estilo clásico • Precisión moderna • Experiencia premium

        </p>

        <div class="hero-rating">

            ★★★★★

            <span>
                Más de <strong>2.500 clientes satisfechos</strong>
            </span>

        </div>

        <div class="botones">

            <a href="/Citas/Crear"
               class="btn-barber">

                Reservar Ahora

            </a>

            <a href="/Servicios"
               class="btn-barber">

                Nuestros Servicios

            </a>

            <a href="/Barberos"
               class="btn-barber">

                Conoce al Equipo

            </a>

        </div>

        <div class="cumple-box">

            <div class="birthday-badge">
                EXCLUSIVO PARA CLIENTES
            </div>

            <h3 class="birthday-title">
                <i class="bi bi-gift-fill me-2"></i>
                Cumpleaños VIP
            </h3>

            <div class="birthday-divider"></div>

            <p class="birthday-text">
                Porque tu estilo también merece celebrarse.
            </p>

            <p class="birthday-text">
                En <strong>Ollin Barber</strong> te obsequiamos un
                <strong>corte de cabello de cortesía</strong>
                para que disfrutes tu día con la mejor imagen.
            </p>

        </div>

        @if (!User.Identity.IsAuthenticated)
        {
            <a href="/Auth/Register" class="btn-registro">
                Crear cuenta
            </a>

            <div class="login-texto">
                ¿Ya tienes cuenta?
                <a href="/Auth/Login">Inicia sesión</a>
            </div>
        }
        
    </div>

</section>