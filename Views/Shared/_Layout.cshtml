@inject OllinBarberApp.Data.ApplicationDbContext Db

@{
    var configuracion = Db.ConfiguracionSistema
        .OrderByDescending(c => c.Id)
        .FirstOrDefault();

    var tiendaActiva = configuracion?.TiendaActiva == true;

    var whatsappUrl = TempData["WhatsAppUrl"] as string;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Ollin Barber</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

    <!-- GOOGLE FONTS PREMIUM -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        :root {
            --gold: #C8A96B;
            --gold-soft: #d4af37;
            --black: #050505;
            --dark: #0d0d0d;
            --dark-soft: #121212;
            --text: #f5f5f5;
            --text-soft: rgba(255,255,255,.72);
            --border: rgba(200,169,107,.18);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
            background: var(--dark);
            color: var(--text);
            font-family: 'Inter', sans-serif;
        }

        body {
            min-height: 100vh;
            background: radial-gradient(circle at top, rgba(200,169,107,.06), transparent 35%), #0d0d0d;
        }

        /* NAVBAR */

        .navbar-ollin {
            position: sticky;
            top: 0;
            z-index: 99999;
            overflow: visible !important;
            background: rgba(5,5,5,.88);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            padding: 14px 26px;
            box-shadow: 0 10px 35px rgba(0,0,0,.45);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
        }
            
        .logo-area img {
            width: 120px;
            height: 120px;
            object-fit: contain;
            filter: drop-shadow(0 0 18px rgba(200,169,107,.25));
            transition: .3s ease;
        }

            .logo-area img:hover {
                transform: scale(1.05);
            }

        .logo-title {
            font-family: 'Cinzel', serif;
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 3px;
            color: var(--gold);
            white-space: nowrap;
        }

        .navbar-collapse {
            justify-content: space-between;
            overflow: visible !important;
        }

        .navbar-nav,
        .dropdown,
        .dropdown-menu {
            overflow: visible !important;
        }

        .nav-link {
            color: var(--text-soft) !important;
            font-size: .88rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 10px 16px !important;
            border-radius: 12px;
            transition: .25s ease;
            position: relative;
        }

            .nav-link:hover {
                color: var(--gold) !important;
                background: rgba(200,169,107,.08);
            }

            .nav-link::after {
                content: "";
                position: absolute;
                left: 18px;
                bottom: 6px;
                width: 0%;
                height: 1px;
                background: var(--gold);
                transition: .25s ease;
            }

            .nav-link:hover::after {
                width: calc(100% - 36px);
            }

        .admin-btn {
            border: 1px solid rgba(200,169,107,.22);
            background: rgba(200,169,107,.05);
        }

        /* DROPDOWN */

        .dropdown-menu {
            background: rgba(18,18,18,.98) !important;
            border: 1px solid rgba(200,169,107,.16);
            border-radius: 18px;
            padding: 12px;
            min-width: 240px;
            box-shadow: 0 20px 50px rgba(0,0,0,.55), 0 0 30px rgba(200,169,107,.06);
            backdrop-filter: blur(18px);
            animation: dropdownFade .22s ease;
        }

        @@keyframes dropdownFade {
            from

        {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* TOGGLER */

        .navbar-toggler {
            border: 1px solid rgba(200,169,107,.22);
            box-shadow: none !important;
        }

        .navbar-toggler-icon {
            filter: invert(1);
        }

        /* ALERTAS */

        .alert-gold {
            width: min(920px, calc(100% - 24px));
            margin: 20px auto;
            padding: 16px;
            border-radius: 18px;
            background: rgba(20,20,20,.96);
            border: 1px solid rgba(200,169,107,.18);
            color: #f7e7b4;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,.35);
        }

        /* MAIN */

        .main-content {
            min-height: calc(100vh - 160px);
            padding-bottom: 40px;
        }

        /* FOOTER */

        footer {
            border-top: 1px solid rgba(200,169,107,.14);
            background: #050505;
            padding: 24px;
            text-align: center;
            color: rgba(255,255,255,.55);
            font-size: .9rem;
            letter-spacing: 1px;
        }

        /* SCROLLBAR */

        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #0d0d0d;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(200,169,107,.35);
            border-radius: 50px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: rgba(200,169,107,.6);
            }

        /* MOBILE */

        @@media(max-width:991px) {

            .navbar-ollin {
                padding: 14px 26px;
            }

            .navbar-collapse {
                margin-top: 18px;
                padding: 20px;
                border-radius: 22px;
                background: rgba(10,10,10,.98);
                border: 1px solid rgba(200,169,107,.12);
            }

            .navbar-nav {
                align-items: stretch;
                gap: 4px;
            }

            .nav-link {
                padding: 14px !important;
                text-align: center;
            }

            .logo-title {
                font-size: 1.2rem;
                letter-spacing: 2px;
            }

            .logo-area img {
                width: 90px;
                height: 90px;
            }
        }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-ollin">

        <div class="container-fluid">

            <a href="/"
               class="navbar-brand">

                <div class="logo-area">

                    <img src="/images/logo.png"
                         alt="Ollin Barber" />

                </div>

                <div class="logo-title">
                    OLLIN BARBER
                </div>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal">

                <span style="font-size:28px;color:#C8A96B;">☰</span>

            </button>

            <div class="collapse navbar-collapse"
                 id="menuPrincipal">

                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/">
                            Inicio
                        </a>
                    </li>

                    @if (User.IsInRole("Admin") || User.IsInRole("Barbero"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               href="/Citas/Agenda">
                                Agenda
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/Servicios">
                            Servicios
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/Citas/Agenda">
                            Agenda
                        </a>
                    </li>

                    @if (tiendaActiva)
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               href="/Tienda">
                                Tienda
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle admin-btn"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                Panel Admin

                            </a>

                            <ul class="dropdown-menu dropdown-menu-dark">

                                <li>
                                    <a class="dropdown-item"
                                       href="/Admin">
                                        Dashboard
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       href="/Admin/Dashboard">
                                        Finanzas
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       href="/Admin/Servicios">
                                        Servicios
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       href="/Admin/Barberos">
                                        Barberos
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       href="/Admin/Productos">
                                        Productos
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       href="/Admin/Ventas">
                                        Ventas
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       href="/Admin/Configuracion">
                                        Configuración
                                    </a>
                                </li>

                            </ul>

                        </li>
                    }

                </ul>

                <ul class="navbar-nav">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Auth/Logout">

                                Salir

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Auth/Login">

                                Login

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link admin-btn"
                               href="/Auth/Register">

                                Registro

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    @if (TempData["ok"] != null)
    {
        <div class="alert-gold">
            @TempData["ok"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert-gold">
            @TempData["Success"]
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(whatsappUrl))
    {
        <div class="alert-gold">

            <a class="btn btn-warning fw-bold"
               target="_blank"
               rel="noopener"
               href="@whatsappUrl">

                Enviar confirmación por WhatsApp

            </a>

        </div>
    }

    <main class="main-content">

        @RenderBody()

    </main>

    <footer>

        © 2026 Ollin Barber — Premium Experience

    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        lucide.createIcons();
    </script>

</body>

</html>