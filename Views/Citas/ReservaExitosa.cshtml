@model OllinBarberApp.Models.Cita

@{
    var whatsapp = ViewBag.WhatsAppUrl as string;
}

<style>

    body{
        background:#0b0b0b;
    }

    .success-container{
        max-width:700px;
        margin:70px auto;
        padding:45px;
        border-radius:25px;
        background:#141414;
        border:1px solid rgba(212,175,55,.25);
        box-shadow:0 0 45px rgba(0,0,0,.55);
        text-align:center;
    }

    .check{
        width:120px;
        height:120px;
        margin:auto;
        border-radius:50%;
        background:#d4af37;
        color:#111;
        font-size:65px;
        display:flex;
        justify-content:center;
        align-items:center;
        font-weight:bold;
        animation:zoom .5s ease;
    }

    @@keyframes zoom{

        from{
            transform:scale(.2);
            opacity:0;
        }

        to{
            transform:scale(1);
            opacity:1;
        }

    }

    h1{
        color:#d4af37;
        margin-top:25px;
        font-size:38px;
    }

    p{
        color:#ddd;
        font-size:18px;
    }

    .info{
        margin-top:35px;
        text-align:left;
        background:#1c1c1c;
        border-radius:18px;
        padding:25px;
    }

    .info strong{
        color:#d4af37;
    }

    .btn-gold{

        display:block;
        width:100%;
        padding:18px;
        margin-top:25px;

        background:#d4af37;
        color:black;
        text-decoration:none;

        border-radius:15px;

        font-weight:bold;

        transition:.3s;

    }

    .btn-gold:hover{

        transform:translateY(-3px);

    }

    .btn-dark{

        display:block;
        width:100%;
        padding:18px;
        margin-top:15px;

        background:#222;
        color:white;
        text-decoration:none;

        border-radius:15px;

        border:1px solid #444;

    }

</style>

<div class="success-container">

    <div class="check">
        ✓
    </div>

    <h1>
        ¡Reserva registrada!
    </h1>

    <p>

        Tu solicitud fue enviada correctamente.

        <br><br>

        El barbero recibirá la notificación y confirmará tu cita.

    </p>

    <div class="info">

        <p>
            <strong>Cliente:</strong>
            @Model.ClienteNombre
        </p>

        <p>
            <strong>Barbero:</strong>
            @Model.Barbero
        </p>

        <p>
            <strong>Fecha:</strong>
            @Model.FechaHora.ToString("dd/MM/yyyy")
        </p>

        <p>
            <strong>Hora:</strong>
            @Model.FechaHora.ToString("hh:mm tt")
        </p>

    </div>

    @if (!string.IsNullOrWhiteSpace(whatsapp))
    {
        <a href="@whatsapp"
           target="_blank"
           class="btn-gold">

            📲 Abrir WhatsApp

        </a>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn-dark">

        🏠 Volver al Inicio

    </a>

</div>