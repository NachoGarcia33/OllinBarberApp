@model List<OllinBarberApp.Models.Cita>
@using OllinBarberApp.Models

@{
    var barberos = (List<Barbero>)ViewBag.Barberos;
    var fecha = ViewBag.Fecha as string;
    int? barberoId = ViewBag.BarberoId as int?;
}

<style>
    .citas-shell {
        width: min(1120px, calc(100% - 24px));
        margin: 30px auto 60px;
    }

    .citas-title {
        color: #d4af37;
        font-family: 'Playfair Display', serif;
        text-align: center;
        margin-bottom: 22px;
    }

    .filters {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) minmax(260px, 2fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .filter-box {
        background: #111;
        border: 1px solid rgba(212, 175, 55, .4);
        border-radius: 8px;
        padding: 16px;
    }

    .barber-links {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .barber-links a {
        color: #d4af37;
        border: 1px solid #3a3320;
        border-radius: 999px;
        padding: 7px 12px;
        text-decoration: none;
    }

    .barber-links a.active,
    .barber-links a:hover {
        background: #d4af37;
        color: #0d0d0d;
    }

    .citas-table {
        min-width: 760px;
        margin-bottom: 0;
    }

    .estado {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-weight: 700;
        min-width: 92px;
    }

    .pendiente { background: #d99a19; color: #111; }
    .atendido { background: #1d8f52; color: #fff; }
    .cancelada { background: #943333; color: #fff; }
    .noasistio { background: #555; color: #fff; }

    @@media (max-width: 760px) {
        .filters {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="citas-shell">
    <h1 class="citas-title">Citas agendadas</h1>

    <div class="filters">
        <form method="get" class="filter-box">
            <label class="form-label text-warning">Filtrar por fecha</label>
            <input type="date" name="fecha" value="@fecha" class="form-control mb-2" />
            <input type="hidden" name="barberoId" value="@barberoId" />
            <button type="submit" class="btn btn-warning fw-bold">Buscar</button>
        </form>

        <div class="filter-box">
            <div class="text-warning fw-bold mb-2">Barbero</div>
            <div class="barber-links">
                <a class="@(barberoId == null ? "active" : "")" href="/Citas/Index@(string.IsNullOrWhiteSpace(fecha) ? "" : $"?fecha={fecha}")">
                    Todos
                </a>
                @foreach (var barbero in barberos)
                {
                    var url = string.IsNullOrWhiteSpace(fecha)
                        ? $"/Citas/Index?barberoId={barbero.Id}"
                        : $"/Citas/Index?barberoId={barbero.Id}&fecha={fecha}";

                    <a class="@(barberoId == barbero.Id ? "active" : "")" href="@url">
                        @barbero.Nombre
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover citas-table">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Teléfono</th>
                    <th>Fecha</th>
                    <th>Barbero</th>
                    <th>Servicio</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cita in Model)
                {
                    var claseEstado = cita.Estado switch
                    {
                        EstadoCita.Pendiente => "estado pendiente",
                        EstadoCita.Atendido => "estado atendido",
                        EstadoCita.Cancelada => "estado cancelada",
                        EstadoCita.NoAsistio => "estado noasistio",
                        _ => "estado"
                    };

                    var estadoTexto = cita.Estado == EstadoCita.NoAsistio
                        ? "No asistió"
                        : cita.Estado.ToString();

                    <tr>
                        <td>@cita.ClienteNombre</td>
                        <td>@cita.Telefono</td>
                        <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(cita.BarberoEntidad?.Nombre ?? cita.Barbero)</td>
                        <td>@(cita.Servicio?.Nombre ?? "Servicio no disponible")</td>
                        <td><span class="@claseEstado">@estadoTexto</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
