@model List<OllinBarberApp.Models.Servicio>

<section class="container py-5">

    <div class="text-center mb-5">

        <h1 class="titulo-servicios">
            Nuestros Servicios
        </h1>

        <p class="subtitulo-servicios">
            Descubre la experiencia premium Ollin Barber
        </p>

    </div>

    <div class="row g-4">

        @foreach (var servicio in Model)
        {
            <div class="col-lg-4 col-md-6">

                <div class="servicio-card">

                    @if (!string.IsNullOrEmpty(servicio.ImagenUrl))
                    {
                        <img src="@servicio.ImagenUrl"
                             class="servicio-imagen">
                    }

                    <div class="servicio-body">

                        <h3 class="servicio-titulo">
                            @servicio.Nombre
                        </h3>

                        <div class="servicio-tipo">
                            @servicio.Tipo
                        </div>

                        <div class="servicio-duracion">
                            ⏱ @servicio.Duracion minutos
                        </div>

                        <div class="servicio-precio">
                            @servicio.Precio.ToString("C0")
                        </div>

                        <a href="/Citas/Crear"
                           class="btn-servicio">

                            Agendar Servicio

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

<style>

    .titulo-servicios {
        color: #C8A96B;
        font-family: 'Cinzel',serif;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .subtitulo-servicios {
        color: rgba(255,255,255,.70);
    }

    .servicio-card {
        background: rgba(18,18,18,.97);
        border: 1px solid rgba(200,169,107,.15);
        border-radius: 24px;
        overflow: hidden;
        height: 100%;
        transition: .3s;
        box-shadow: 0 20px 40px rgba(0,0,0,.35);
    }

        .servicio-card:hover {
            transform: translateY(-6px);
            border-color: #C8A96B;
        }

    .servicio-imagen {
        width: 100%;
        height: 260px;
        object-fit: cover;
    }

    .servicio-body {
        padding: 25px;
    }

    .servicio-titulo {
        color: #C8A96B;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .servicio-tipo {
        color: #ddd;
        margin-bottom: 10px;
    }

    .servicio-duracion {
        color: #aaa;
        margin-bottom: 15px;
    }

    .servicio-precio {
        color: #d4af37;
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .btn-servicio {
        display: block;
        width: 100%;
        text-align: center;
        text-decoration: none;
        background: linear-gradient( 135deg, #C8A96B, #d4af37 );
        color: black;
        padding: 14px;
        border-radius: 14px;
        font-weight: 700;
        transition: .3s;
    }

        .btn-servicio:hover {
            transform: translateY(-2px);
            color: black;
        }

</style>