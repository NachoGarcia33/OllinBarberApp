@model OllinBarberApp.Models.Barbero

<section class="container py-4" style="max-width:680px;">
    <h1 class="mb-3" style="color:#d4af37;">
        Nuevo barbero
    </h1>

    <form method="post"
          enctype="multipart/form-data"
          class="bg-dark border border-warning rounded p-4">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label text-warning">
                Nombre
            </label>

            <input asp-for="Nombre"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label text-warning">
                Teléfono
            </label>

            <input asp-for="Telefono"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label text-warning">
                Imagen del barbero
            </label>

            <input type="file"
                   name="imagen"
                   class="form-control"
                   accept="image/*" />
        </div>

        <div class="form-check mb-2">
            <input class="form-check-input"
                   asp-for="Disponible" />

            <label class="form-check-label">
                Disponible
            </label>
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input"
                   asp-for="Activo" />

            <label class="form-check-label">
                Activo
            </label>
        </div>

        <button type="submit"
                class="btn btn-warning fw-bold w-100">
            Guardar barbero
        </button>

    </form>
</section>