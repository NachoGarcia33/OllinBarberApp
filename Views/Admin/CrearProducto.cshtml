@model OllinBarberApp.Models.Producto

<section class="container py-4" style="max-width:760px;">
    <h1 class="mb-3" style="color:#d4af37;">Nuevo producto</h1>

    <form method="post"
          enctype="multipart/form-data"
          class="bg-dark border border-warning rounded p-4">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Categoría</label>
            <input asp-for="Categoria" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Precio</label>
                <input asp-for="Precio"
                       type="number"
                       min="0"
                       step="100"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Stock</label>
                <input asp-for="Stock"
                       type="number"
                       min="0"
                       class="form-control" />
            </div>
        </div>

        <div class="mb-3 mt-3">
            <label class="form-label">
                Imagen del producto
            </label>

            <input type="file"
                   name="ImagenArchivo"
                   class="form-control"
                   accept="image/*" />
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input"
                   asp-for="Activo" />

            <label class="form-check-label">
                Activo
            </label>
        </div>

        <button class="btn btn-warning fw-bold w-100">
            Guardar producto
        </button>
    </form>
</section>