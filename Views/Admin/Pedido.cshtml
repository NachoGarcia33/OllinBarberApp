@model OllinBarberApp.Models.Pedido
@using OllinBarberApp.Models
@{ ViewData["Title"] = "Pedido " + Model.Codigo; }
<section class="container py-4" style="max-width:1050px">
    <div class="d-flex justify-content-between gap-3 flex-wrap align-items-start mb-3"><div><a asp-action="Pedidos" class="text-warning text-decoration-none">← Pedidos</a><h1 class="mt-2" style="color:#d4af37;">@Model.Codigo</h1><div class="text-white-50">Creado @Model.Fecha.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")</div></div><span class="badge fs-6 text-bg-secondary">@Model.Estado</span></div>
    <div class="row g-3">
        <div class="col-lg-7"><div class="bg-dark border border-secondary rounded-3 p-3 h-100"><h2 class="h5 text-warning">Productos</h2><div class="table-responsive"><table class="table table-dark align-middle"><thead><tr><th>Producto</th><th>Cant.</th><th>Precio</th><th>Desc.</th><th>Subtotal</th></tr></thead><tbody>@foreach(var d in Model.Detalles){<tr><td>@(d.Producto?.Nombre ?? $"Producto #{d.ProductoId}")</td><td>@d.Cantidad</td><td>@d.PrecioUnitario.ToString("C0")</td><td>@d.DescuentoUnitario.ToString("C0")</td><td>@d.Subtotal.ToString("C0")</td></tr>}</tbody></table></div><hr/><div class="d-flex justify-content-between"><span>Subtotal</span><strong>@Model.Subtotal.ToString("C0")</strong></div><div class="d-flex justify-content-between"><span>Descuentos</span><strong class="text-success">-@Model.DescuentoTotal.ToString("C0")</strong></div><div class="d-flex justify-content-between fs-5 text-warning mt-2"><span>Total</span><strong>@Model.Total.ToString("C0")</strong></div></div></div>
        <div class="col-lg-5"><div class="bg-dark border border-secondary rounded-3 p-3 mb-3"><h2 class="h5 text-warning">Cliente y entrega</h2><div><strong>@Model.ClienteNombre</strong></div><div>@Model.Email</div><div>@Model.Telefono</div><div class="mt-2">@Model.Direccion, @Model.Ciudad</div><div class="text-white-50 mt-2">@Model.MetodoEntrega · @Model.MetodoPago</div>@if(!string.IsNullOrWhiteSpace(Model.Notas)){<div class="mt-2"><strong>Notas:</strong> @Model.Notas</div>}</div>
        <div class="bg-dark border border-warning rounded-3 p-3"><h2 class="h5 text-warning">Actualizar estado</h2>@if(Model.Estado is EstadoPedido.Entregado or EstadoPedido.Cancelado){<p class="text-white-50 mb-0">Este pedido está cerrado y no admite más cambios.</p>}else{var siguientes = Model.Estado switch { EstadoPedido.Pendiente => new[] { EstadoPedido.Confirmado, EstadoPedido.Cancelado }, EstadoPedido.Confirmado => new[] { EstadoPedido.Procesando, EstadoPedido.Cancelado }, EstadoPedido.Procesando => new[] { EstadoPedido.Enviado, EstadoPedido.Cancelado }, EstadoPedido.Enviado => new[] { EstadoPedido.Entregado }, _ => Array.Empty<EstadoPedido>() };<form asp-action="ActualizarEstadoPedido" method="post"><input type="hidden" name="id" value="@Model.Id" /><label class="form-label" for="estado">Siguiente estado</label><select id="estado" name="estado" class="form-select mb-2">@foreach(var e in siguientes){<option value="@e">@e</option>}</select><button class="btn btn-warning fw-bold w-100" type="submit">Guardar estado</button></form>}</div></div>
    </div>
</section>
