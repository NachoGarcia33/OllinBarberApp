@model List<OllinBarberApp.Models.Barbero>

<section class="container py-4">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
        <h1 class="m-0" style="color:#d4af37;">Administrar barberos</h1>
        <a href="/Admin/CrearBarbero" class="btn btn-warning fw-bold">Agregar barbero</a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Barbero</th>
                    <th>Teléfono</th>
                    <th>Disponible</th>
                    <th>Activo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Nombre</strong>
                            @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                            {
                                <div class="text-white-50 small">@item.ImagenUrl</div>
                            }
                        </td>
                        <td>@item.Telefono</td>
                        <td>@(item.Disponible ? "Sí" : "No")</td>
                        <td>@(item.Activo ? "Sí" : "No")</td>
                        <td class="d-flex gap-2 flex-wrap">
                            <a href="/Admin/EditarBarbero/@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            @if (item.Activo)
                            {
                                <a href="/Admin/EliminarBarbero/@item.Id" class="btn btn-sm btn-outline-danger">Desactivar</a>
                            }
                            else
                            {
                                <a href="/Admin/ActivarBarbero/@item.Id" class="btn btn-sm btn-outline-success">Activar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
