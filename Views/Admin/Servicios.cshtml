@model List<OllinBarberApp.Models.Servicio>

<section class="container py-4">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
        <h1 class="m-0" style="color:#d4af37;">Servicios</h1>
        <a href="/Admin/CrearServicio" class="btn btn-warning fw-bold">Agregar servicio</a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Duración</th>
                    <th>Precio</th>
                    <th>Tipo</th>
                    <th>Activo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Duracion min</td>
                        <td>@item.Precio.ToString("C0")</td>
                        <td>@item.Tipo</td>
                        <td>@(item.Activo ? "Sí" : "No")</td>
                        <td class="d-flex gap-2 flex-wrap">
                            <a href="/Admin/EditarServicio/@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            @if (item.Activo)
                            {
                                <a href="/Admin/EliminarServicio/@item.Id" class="btn btn-sm btn-outline-danger">Desactivar</a>
                            }
                            else
                            {
                                <a href="/Admin/ActivarServicio/@item.Id" class="btn btn-sm btn-outline-success">Activar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
