@model List<OllinBarberApp.Models.Producto>

<section class="container py-4">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
        <h1 class="m-0" style="color:#d4af37;">Productos de tienda</h1>
        <a href="/Admin/CrearProducto" class="btn btn-warning fw-bold">Agregar producto</a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Activo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Nombre</strong>
                            <div class="text-white-50 small">@item.Descripcion</div>
                        </td>
                        <td>@item.Categoria</td>
                        <td>@item.Precio.ToString("C0")</td>
                        <td>@item.Stock</td>
                        <td>@(item.Activo ? "Sí" : "No")</td>
                        <td class="d-flex gap-2 flex-wrap">
                            <a href="/Admin/EditarProducto/@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            @if (item.Activo)
                            {
                                <a href="/Admin/EliminarProducto/@item.Id" class="btn btn-sm btn-outline-danger">Desactivar</a>
                            }
                            else
                            {
                                <a href="/Admin/ActivarProducto/@item.Id" class="btn btn-sm btn-outline-success">Activar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
